<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>bdmanager</RootNamespace>
    <Product>ByeDPI Manager</Product>
    <AssemblyName>ByeDPI Manager</AssemblyName>
    <Authors>romanvht</Authors>
    <Description>Менеджер для ByeDPI и ProxiFyre</Description>
    <ApplicationIcon>src\resources\icons\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.1</Version>
    <Copyright>romanvht</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="src\resources\icons\icon.ico" />
    <Resource Include="src\resources\icons\icon.ico" />
    <EmbeddedResource Include="src\resources\icons\tray-on.ico">
      <LogicalName>bdmanager.tray-on.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="src\resources\icons\tray-off.ico">
      <LogicalName>bdmanager.tray-off.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="locale\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="src\App.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SocksSharp" Version="1.1.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="proxytest\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
