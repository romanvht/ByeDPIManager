<Window x:Class="bdmanager.Views.DependencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="670"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Icon="/src/resources/icons/icon.ico"
        Background="{StaticResource DarkWindowBrush}"
        Foreground="White">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,13" Margin="0,0,0,12"
            Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="!" Foreground="{StaticResource DarkWarningBrush}" FontSize="32" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
          <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="16,12" Margin="0,0,0,12"
            Background="{StaticResource DarkCardBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <TextBlock x:Name="WarningText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="RedistText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,5" />
        <TextBlock x:Name="RestartText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
      <ItemsControl x:Name="LinksItemsControl">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="16,10" Margin="0,0,0,10"
                    Background="{StaticResource DarkPanelBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Cursor="Hand" Tag="{Binding Url}" MouseLeftButtonUp="DependencyCard_Click">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Foreground="LimeGreen" FontWeight="Bold" />
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding OpenText}" Foreground="{StaticResource MutedTextBrush}"
                           FontWeight="Bold" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="3" x:Name="OkButton" Width="110" Height="38"
            HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
            Style="{StaticResource RoundedGrayButton}" Click="OkButton_Click" />
  </Grid>
</Window>
