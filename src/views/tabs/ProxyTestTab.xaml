<UserControl x:Class="bdmanager.Views.Tabs.ProxyTestTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:bdmanager">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <GroupBox Header="{local:Loc settings_form.proxy_test.settings_group}" Margin="0,0,0,5">
      <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{local:Loc settings_form.proxy_test.delay_label}" />
        <TextBox x:Name="DelayTextBox" Grid.Column="1" PreviewTextInput="IntegerTextBox_PreviewTextInput" />
        <TextBlock Grid.Row="1" Margin="0,7,0,0" VerticalAlignment="Center" Text="{local:Loc settings_form.proxy_test.requests_label}" />
        <TextBox x:Name="RequestsCountTextBox" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                 PreviewTextInput="IntegerTextBox_PreviewTextInput" />
        <TextBlock Grid.Row="2" Margin="0,7,0,0" VerticalAlignment="Center" Text="{local:Loc settings_form.proxy_test.sni_label}" />
        <TextBox x:Name="SniTextBox" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button Content="{local:Loc settings_form.proxy_test.edit_domains}" Margin="0,0,4,0" Click="EditDomains_Click" />
          <Button Grid.Column="1" Content="{local:Loc settings_form.proxy_test.edit_commands}" Margin="4,0,0,0" Click="EditCommands_Click" />
        </Grid>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="{local:Loc settings_form.proxy_test.logs_group}" Margin="0,5,0,0">
      <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl>
          <TabItem Header="{local:Loc settings_form.proxy_test.results_tab}">
            <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MinRowHeight="30" CanUserResizeRows="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                      MouseDoubleClick="ResultsDataGrid_MouseDoubleClick">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{local:Loc settings_form.proxy_test.apply_menu}" Click="ApplyResult_Click" />
                  <MenuItem Header="{local:Loc settings_form.proxy_test.copy_menu}" Click="CopyResult_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Loc settings_form.proxy_test.strategy_column}"
                                    Binding="{Binding Strategy}" Width="*"
                                    ElementStyle="{StaticResource WrappingDataGridCellText}" />
                <DataGridTextColumn Header="{local:Loc settings_form.proxy_test.result_column}"
                                    Binding="{Binding Result}" Width="100"
                                    ElementStyle="{StaticResource CenteredDataGridCellText}"
                                    CellStyle="{StaticResource LeftSeparatedDataGridCell}"
                                    HeaderStyle="{StaticResource CenteredDataGridColumnHeader}" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="{local:Loc settings_form.proxy_test.progress_tab}">
            <TextBox x:Name="ProxyTestLogsTextBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
          </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="ProxyTestStartButton" Content="{local:Loc settings_form.proxy_test.start}" Click="ProxyTestStart_Click" />
          <TextBlock x:Name="ProxyTestProgressText" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="{local:Loc settings_form.proxy_test.alternative_group}" Margin="0,10,0,0">
      <StackPanel Margin="8">
        <TextBlock TextWrapping="Wrap" Text="{local:Loc settings_form.proxy_test.alternative_description}" />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink NavigateUri="https://ntc.party/t/14291" RequestNavigate="AlternativeLink_RequestNavigate">
            <Run Text="{local:Loc settings_form.proxy_test.alternative_link}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </GroupBox>
  </Grid>
</UserControl>
